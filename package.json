{
  "name": "ai-worklog",
  "version": "0.1.3",
  "description": "Claude Code 사용 내역으로 일일·주간·월간 업무 요약을 자동 생성하는 macOS·Windows 트레이 앱",
  "main": "./out/main/index.cjs",
  "author": "bedcoding",
  "license": "MIT",
  "homepage": "https://github.com/bedcoding/ai-worklog",
  "scripts": {
    "dev": "electron-vite dev -w",
    "dev:show": "node scripts/dev-show.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build",
    "test": "vitest run",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "icons": "node scripts/gen-tray-icon.mjs",
    "check:no-network": "node scripts/check-no-network.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
